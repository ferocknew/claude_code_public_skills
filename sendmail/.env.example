# SMTP 服务器配置
# 复制此文件为 .env 并填写实际配置

# SMTP 服务器地址
SMTP_HOST=smtp.gmail.com

# SMTP 服务器端口
# 587 = STARTTLS (推荐)
# 465 = SSL/TLS
SMTP_PORT=587

# 是否使用 SSL/TLS (端口 465 使用 true, 587 使用 false)
SMTP_SECURE=false

# SMTP 用户名（通常是邮箱地址）
SMTP_USER=your-email@gmail.com

# SMTP 密码或应用专用密码
# Gmail 用户需要在 https://myaccount.google.com/apppasswords 生成应用专用密码
SMTP_PASSWORD=your-app-password

# 默认发件人（可选，不设置则使用 SMTP_USER）
SMTP_FROM=your-email@gmail.com

# 默认发件人名称（可选）
SMTP_FROM_NAME=Your Name
