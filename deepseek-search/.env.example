# DeepSeek 搜索 / 抓取 环境变量模板
# 复制本文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到 git；请勿把真实 Key 写进任何提交的文件。

# DeepSeek API Key（必需），与 DeepSeek 模型 API 共用同一套 Key
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API 基础地址（可选，默认 https://api.deepseek.com，通常无需修改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次请求超时，单位毫秒（可选，默认 30000）
# DEEPSEEK_TIMEOUT_MS=30000

# 设为 1 时禁止交互式询问，缺少 Key 时直接报错退出（可选，适合脚本 / CI）
# DEEPSEEK_NO_PROMPT=1
