# Hindsight MCP 配置模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。

# MCP 端点，必须是完整 URL 且已包含 bank 路径，形如：
# https://example.com/mcp/your-bank
HINDSIGHT_MCP_URL=https://example.com/mcp/your-bank

# 访问令牌，工具会自动拼成 "Authorization: Bearer <token>"
HINDSIGHT_TOKEN=your-token-here

# 可选：直接给出完整的 Authorization 头值。设置后优先于 HINDSIGHT_TOKEN。
# HINDSIGHT_AUTH_HEADER=Bearer your-token-here

# 可选：请求超时毫秒数，默认 60000
HINDSIGHT_TIMEOUT_MS=60000
